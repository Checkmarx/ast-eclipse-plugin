<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

    <extension
            point="org.eclipse.ui.preferencePages">
        <page
                class="com.checkmarx.eclipse.properties.PreferencesPage"
                id="com.checkmarx.eclipse.properties.preferencespage"
                name="Checkmarx One">
        </page>
    </extension>
    <extension
          point="org.eclipse.ui.views">
       <view
             category="com.checkmarx.eclipse"
             class="com.checkmarx.eclipse.views.CheckmarxView"
             icon="icons/checkmarx-plugin-13_dark.png"
             id="com.checkmarx.eclipse.views.CheckmarxView"
             inject="true"
             name="Checkmarx One Scan"
             restorable="true">
       </view>
       <view
             category="com.checkmarx.eclipse"
             class="com.checkmarx.eclipse.devassist.ui.findings.CxFindingsView"
             icon="platform:/plugin/com.checkmarx.eclipse.plugin/icons/severity/critical_16.svg"
             id="com.checkmarx.eclipse.devassist.ui.findings.CxFindingsView"
             inject="true"
             name="Checkmarx Findings"
             restorable="true">
       </view>
       <view
             category="com.checkmarx.eclipse"
             class="com.checkmarx.eclipse.devassist.ui.findings.ignored.CxIgnoredProblemsView"
             icon="platform:/plugin/com.checkmarx.eclipse.plugin/icons/severity/low_16.svg"
             id="com.checkmarx.eclipse.devassist.ui.findings.ignored.CxIgnoredProblemsView"
             inject="true"
             name="Checkmarx Ignored Problems"
             restorable="true">
       </view>
       <category
             id="com.checkmarx.eclipse"
             name="Checkmarx">
       </category>
    </extension>
    <extension
            point="org.eclipse.ui.perspectiveExtensions">
        <perspectiveExtension
                targetID="org.eclipse.jdt.ui.JavaPerspective">
            <view
                    id="com.checkmarx.eclipse.views.CheckmarxView"
                    relative="org.eclipse.ui.views.ProblemView"
                    relationship="right"
                    ratio="0.5">
            </view>
            <view
                    id="com.checkmarx.eclipse.devassist.ui.findings.CxFindingsView"
                    relative="org.eclipse.ui.views.ProblemView"
                    relationship="stacked"
                    ratio="0.5">
            </view>
            <view
                    id="com.checkmarx.eclipse.devassist.ui.findings.ignored.CxIgnoredProblemsView"
                    relative="org.eclipse.ui.views.ProblemView"
                    relationship="stacked"
                    ratio="0.5">
            </view>
        </perspectiveExtension>
    </extension>

    <extension point="org.eclipse.ui.startup">
        <startup class="com.checkmarx.eclipse.startup.PluginStartup"/>
    </extension>

    <!-- Register custom marker type for Problems View -->
    <extension
            id="checkmarxProblemMarker"
            point="org.eclipse.core.resources.markers"
            name="Checkmarx Problem">
        <super type="org.eclipse.core.resources.problemmarker"/>
        <persistent value="false"/>
        <attribute name="findingId"/>
        <attribute name="ruleId"/>
        <attribute name="severity"/>
        <attribute name="status"/>
    </extension>

    <!-- Annotation types for each severity level -->
    <extension point="org.eclipse.ui.editors.annotationTypes">
        <type
            markerSeverity="2"
            markerType="com.checkmarx.eclipse.plugin.checkmarxProblemMarker"
            name="com.checkmarx.eclipse.annotation.critical"
            super="org.eclipse.ui.workbench.texteditor.error">
        </type>
        <type
            markerSeverity="2"
            markerType="com.checkmarx.eclipse.plugin.checkmarxProblemMarker"
            name="com.checkmarx.eclipse.annotation.high"
            super="org.eclipse.ui.workbench.texteditor.error">
        </type>
        <type
            markerSeverity="1"
            markerType="com.checkmarx.eclipse.plugin.checkmarxProblemMarker"
            name="com.checkmarx.eclipse.annotation.medium"
            super="org.eclipse.ui.workbench.texteditor.warning">
        </type>
        <type
            markerSeverity="0"
            markerType="com.checkmarx.eclipse.plugin.checkmarxProblemMarker"
            name="com.checkmarx.eclipse.annotation.low"
            super="org.eclipse.ui.workbench.texteditor.info">
        </type>
    </extension>

    <!-- Gutter icon specifications for each severity -->
    <extension point="org.eclipse.ui.editors.markerAnnotationSpecification">
        <specification
            annotationType="com.checkmarx.eclipse.annotation.critical"
            label="Checkmarx Critical"
            icon="icons/severity/critical_16.svg"
            textPreferenceKey="cxAnnotationCriticalText"
            textPreferenceValue="true"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceKey="cxAnnotationCriticalVerticalRuler"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceKey="cxAnnotationCriticalOverviewRuler"
            overviewRulerPreferenceValue="true"
            presentationLayer="7">
        </specification>
        <specification
            annotationType="com.checkmarx.eclipse.annotation.high"
            label="Checkmarx High"
            icon="icons/severity/high_16.svg"
            textPreferenceKey="cxAnnotationHighText"
            textPreferenceValue="true"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceKey="cxAnnotationHighVerticalRuler"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceKey="cxAnnotationHighOverviewRuler"
            overviewRulerPreferenceValue="true"
            presentationLayer="6">
        </specification>
        <specification
            annotationType="com.checkmarx.eclipse.annotation.medium"
            label="Checkmarx Medium"
            icon="icons/severity/medium_16.svg"
            textPreferenceKey="cxAnnotationMediumText"
            textPreferenceValue="true"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceKey="cxAnnotationMediumVerticalRuler"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceKey="cxAnnotationMediumOverviewRuler"
            overviewRulerPreferenceValue="true"
            presentationLayer="5">
        </specification>
        <specification
            annotationType="com.checkmarx.eclipse.annotation.low"
            label="Checkmarx Low"
            icon="icons/severity/low_16.svg"
            textPreferenceKey="cxAnnotationLowText"
            textPreferenceValue="true"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceKey="cxAnnotationLowVerticalRuler"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceKey="cxAnnotationLowOverviewRuler"
            overviewRulerPreferenceValue="true"
            presentationLayer="4">
        </specification>
    </extension>


    <!-- Command for publishing mock problems (for testing) -->
    <extension point="org.eclipse.ui.commands">
        <command
                id="com.checkmarx.eclipse.problems.command.publishMock"
                name="Publish Mock Checkmarx Problems"
                description="Publish mock/dummy Checkmarx problems to the Problems View for testing">
        </command>
        <command
                id="com.checkmarx.eclipse.problems.command.action1"
                name="Ignore This Problem"
                description="Ignore this problem and move it to the Ignored Problems window">
        </command>

        <!-- Severity filter commands for Problems View -->
        <command
                id="com.checkmarx.eclipse.problems.filter.critical"
                name="Filter: CRITICAL"
                description="Show only CRITICAL severity problems">
            <commandParameter
                    id="com.checkmarx.eclipse.severity"
                    name="Severity"
                    optional="false">
            </commandParameter>
        </command>
        <command
                id="com.checkmarx.eclipse.problems.filter.high"
                name="Filter: HIGH"
                description="Show only HIGH severity problems">
            <commandParameter
                    id="com.checkmarx.eclipse.severity"
                    name="Severity"
                    optional="false">
            </commandParameter>
        </command>
        <command
                id="com.checkmarx.eclipse.problems.filter.medium"
                name="Filter: MEDIUM"
                description="Show only MEDIUM severity problems">
            <commandParameter
                    id="com.checkmarx.eclipse.severity"
                    name="Severity"
                    optional="false">
            </commandParameter>
        </command>
        <command
                id="com.checkmarx.eclipse.problems.filter.low"
                name="Filter: LOW"
                description="Show only LOW severity problems">
            <commandParameter
                    id="com.checkmarx.eclipse.severity"
                    name="Severity"
                    optional="false">
            </commandParameter>
        </command>
        <command
                id="com.checkmarx.eclipse.problems.filter.all"
                name="Show All Problems"
                description="Clear severity filter and show all problems">
            <commandParameter
                    id="com.checkmarx.eclipse.severity"
                    name="Severity"
                    optional="false">
            </commandParameter>
        </command>
    </extension>

    <!-- Handlers for problems commands -->
    <extension point="org.eclipse.ui.handlers">
        <handler
                commandId="com.checkmarx.eclipse.problems.command.publishMock"
                class="com.checkmarx.eclipse.devassist.problems.commands.PublishMockProblemsHandler">
        </handler>
        <handler
                commandId="com.checkmarx.eclipse.problems.command.action1"
                class="com.checkmarx.eclipse.devassist.problems.commands.ProblemAction1Handler">
        </handler>

        <!-- Severity filter handlers -->
        <handler
                commandId="com.checkmarx.eclipse.problems.filter.critical"
                class="com.checkmarx.eclipse.devassist.problems.commands.FilterBySeverityHandler">
        </handler>
        <handler
                commandId="com.checkmarx.eclipse.problems.filter.high"
                class="com.checkmarx.eclipse.devassist.problems.commands.FilterBySeverityHandler">
        </handler>
        <handler
                commandId="com.checkmarx.eclipse.problems.filter.medium"
                class="com.checkmarx.eclipse.devassist.problems.commands.FilterBySeverityHandler">
        </handler>
        <handler
                commandId="com.checkmarx.eclipse.problems.filter.low"
                class="com.checkmarx.eclipse.devassist.problems.commands.FilterBySeverityHandler">
        </handler>
        <handler
                commandId="com.checkmarx.eclipse.problems.filter.all"
                class="com.checkmarx.eclipse.devassist.problems.commands.FilterBySeverityHandler">
        </handler>
    </extension>

    <!-- Marker resolution generator for Quick Fix support (Ctrl+1) -->
    <!-- Register for base marker type - all severity-specific types inherit from it -->
    <extension point="org.eclipse.ui.markerResolutionGenerators">
        <generator
                class="com.checkmarx.eclipse.devassist.ui.findings.resolution.CheckmarxMarkerResolutionGenerator"
                markerType="com.checkmarx.eclipse.plugin.checkmarxProblemMarker">
        </generator>
    </extension>

    <!-- Menu contribution for Ignore action in Problems View -->
    <extension point="org.eclipse.ui.menus">
        <menuContribution locationURI="menu:org.eclipse.ui.main.menu">
            <menu id="cx.menu" label="Checkmarx">
                <command
                        commandId="com.checkmarx.eclipse.problems.command.publishMock"
                        label="📋 Publish Test Problems"
                        tooltip="Publish mock Checkmarx problems to Problems View (for testing hover)">
                </command>
            </menu>
        </menuContribution>
        <menuContribution
                locationURI="popup:org.eclipse.ui.views.ProblemView">
            <command
                    commandId="com.checkmarx.eclipse.problems.command.action1"
                    label="Ignore This Problem"
                    tooltip="Mark as ignored and move to Ignored Problems window">
            </command>
        </menuContribution>

        <!-- Toolbar contributions for Problems View severity filters -->
        <menuContribution
                locationURI="toolbar:org.eclipse.ui.views.ProblemView">
            <!-- Filter Status Label showing "Showing X of Y | Active: [...]" -->
            <control
                    class="com.checkmarx.eclipse.devassist.problems.filter.FilterStatusLabelProvider"
                    id="com.checkmarx.eclipse.filter.status.label">
            </control>

            <separator name="group.severity" visible="true"/>

            <command
                    commandId="com.checkmarx.eclipse.problems.filter.critical"
                    label="🔴 CRITICAL"
                    tooltip="Show only CRITICAL severity problems"
                    icon="platform:/plugin/com.checkmarx.eclipse.plugin/icons/severity/critical_16.svg">
                <parameter name="com.checkmarx.eclipse.severity" value="CRITICAL"/>
            </command>

            <command
                    commandId="com.checkmarx.eclipse.problems.filter.high"
                    label="🟠 HIGH"
                    tooltip="Show only HIGH severity problems"
                    icon="platform:/plugin/com.checkmarx.eclipse.plugin/icons/severity/high_16.svg">
                <parameter name="com.checkmarx.eclipse.severity" value="HIGH"/>
            </command>

            <command
                    commandId="com.checkmarx.eclipse.problems.filter.medium"
                    label="🟡 MEDIUM"
                    tooltip="Show only MEDIUM severity problems"
                    icon="platform:/plugin/com.checkmarx.eclipse.plugin/icons/severity/medium_16.svg">
                <parameter name="com.checkmarx.eclipse.severity" value="MEDIUM"/>
            </command>

            <command
                    commandId="com.checkmarx.eclipse.problems.filter.low"
                    label="🟢 LOW"
                    tooltip="Show only LOW severity problems"
                    icon="platform:/plugin/com.checkmarx.eclipse.plugin/icons/severity/low_16.svg">
                <parameter name="com.checkmarx.eclipse.severity" value="LOW"/>
            </command>

            <separator name="group.filter" visible="true"/>

            <command
                    commandId="com.checkmarx.eclipse.problems.filter.all"
                    label="Show All"
                    tooltip="Clear severity filter and show all problems"
                    icon="platform:/plugin/com.checkmarx.eclipse.plugin/icons/severity/info_16.svg">
                <parameter name="com.checkmarx.eclipse.severity" value="ALL"/>
            </command>
        </menuContribution>
    </extension>

    <!-- Java Editor Text Hover - triggers when hovering over code with Checkmarx markers -->
    <extension point="org.eclipse.jdt.ui.javaEditorTextHovers">
        <hover
            id="com.checkmarx.eclipse.hover.java"
            label="Checkmarx Vulnerability Hover"
            description="Displays Checkmarx vulnerability details"
            class="com.checkmarx.eclipse.devassist.problems.hover.CxTextHover">
        </hover>
    </extension>

</plugin>
