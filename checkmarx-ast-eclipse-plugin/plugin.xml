<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

    <extension
            point="org.eclipse.ui.preferencePages">
        <page
                class="com.checkmarx.eclipse.properties.PreferencesPage"
                id="com.checkmarx.eclipse.properties.preferencespage"
                name="Checkmarx One">
        </page>
        <page
                class="com.checkmarx.eclipse.devassist.prefs.CheckmarxPreferencePage"
                id="com.checkmarx.eclipse.devassist.prefs.checkmarxpreferencepage"
                name="Checkmarx Scanner Configuration">
        </page>
    </extension>
    <extension
          point="org.eclipse.ui.views">
       <view
             category="com.checkmarx.eclipse"
             class="com.checkmarx.eclipse.views.CheckmarxView"
             icon="icons/checkmarx-plugin-13_dark.png"
             id="com.checkmarx.eclipse.views.CheckmarxView"
             inject="true"
             name="Checkmarx One Scan"
             restorable="true">
       </view>
       <view
             category="com.checkmarx.eclipse"
             class="com.checkmarx.eclipse.devassist.ui.findings.CxFindingsView"
             icon="platform:/plugin/com.checkmarx.eclipse.plugin/icons/severity/critical_16.svg"
             id="com.checkmarx.eclipse.devassist.ui.findings.CxFindingsView"
             inject="true"
             name="Checkmarx Findings"
             restorable="true">
       </view>
       <view
             category="com.checkmarx.eclipse"
             class="com.checkmarx.eclipse.devassist.ui.findings.ignored.CxIgnoredProblemsView"
             icon="platform:/plugin/com.checkmarx.eclipse.plugin/icons/severity/low_16.svg"
             id="com.checkmarx.eclipse.devassist.ui.findings.ignored.CxIgnoredProblemsView"
             inject="true"
             name="Checkmarx Ignored Problems"
             restorable="true">
       </view>
       <category
             id="com.checkmarx.eclipse"
             name="Checkmarx">
       </category>
    </extension>
    <extension
            point="org.eclipse.ui.perspectiveExtensions">
        <perspectiveExtension
                targetID="org.eclipse.jdt.ui.JavaPerspective">
            <view
                    id="com.checkmarx.eclipse.views.CheckmarxView"
                    relative="org.eclipse.ui.views.ProblemView"
                    relationship="right"
                    ratio="0.5">
            </view>
            <view
                    id="com.checkmarx.eclipse.devassist.ui.findings.CxFindingsView"
                    relative="org.eclipse.ui.views.ProblemView"
                    relationship="stacked"
                    ratio="0.5">
            </view>
            <view
                    id="com.checkmarx.eclipse.devassist.ui.findings.ignored.CxIgnoredProblemsView"
                    relative="org.eclipse.ui.views.ProblemView"
                    relationship="stacked"
                    ratio="0.5">
            </view>
        </perspectiveExtension>
    </extension>

    <extension point="org.eclipse.ui.startup">
        <startup class="com.checkmarx.eclipse.startup.PluginStartup"/>
    </extension>

    <!-- Annotation types for custom Findings Window editor decorations (gutter icons + underlines) -->
    <extension point="org.eclipse.ui.editors.annotationTypes">
        <type
            name="com.checkmarx.eclipse.findings.malicious"
            super="org.eclipse.ui.workbench.texteditor.error">
        </type>
        <type
            name="com.checkmarx.eclipse.findings.critical"
            super="org.eclipse.ui.workbench.texteditor.error">
        </type>
        <type
            name="com.checkmarx.eclipse.findings.high"
            super="org.eclipse.ui.workbench.texteditor.error">
        </type>
        <type
            name="com.checkmarx.eclipse.findings.medium"
            super="org.eclipse.ui.workbench.texteditor.warning">
        </type>
        <type
            name="com.checkmarx.eclipse.findings.low"
            super="org.eclipse.ui.workbench.texteditor.info">
        </type>
        <type
            name="com.checkmarx.eclipse.findings.unknown"
            super="org.eclipse.ui.workbench.texteditor.info">
        </type>
        <type
            name="com.checkmarx.eclipse.findings.ok"
            super="org.eclipse.ui.workbench.texteditor.info">
        </type>
        <type
            name="com.checkmarx.eclipse.findings.ignored"
            super="org.eclipse.ui.workbench.texteditor.info">
        </type>
    </extension>

    <!-- Gutter icon + squiggly underline specifications for Findings annotations -->
    <extension point="org.eclipse.ui.editors.markerAnnotationSpecification">
        <specification
            annotationType="com.checkmarx.eclipse.findings.malicious"
            label="Checkmarx Malicious Finding"
            icon="icons/severity/malicious_16.svg"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceValue="true"
            presentationLayer="8">
        </specification>
        <specification
            annotationType="com.checkmarx.eclipse.findings.critical"
            label="Checkmarx Critical Finding"
            icon="icons/severity/critical_16.svg"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceValue="true"
            presentationLayer="7">
        </specification>
        <specification
            annotationType="com.checkmarx.eclipse.findings.high"
            label="Checkmarx High Finding"
            icon="icons/severity/high_16.svg"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceValue="true"
            presentationLayer="6">
        </specification>
        <specification
            annotationType="com.checkmarx.eclipse.findings.medium"
            label="Checkmarx Medium Finding"
            icon="icons/severity/medium_16.svg"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceValue="true"
            presentationLayer="5">
        </specification>
        <specification
            annotationType="com.checkmarx.eclipse.findings.low"
            label="Checkmarx Low Finding"
            icon="icons/severity/low_16.svg"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceValue="true"
            presentationLayer="4">
        </specification>
        <specification
            annotationType="com.checkmarx.eclipse.findings.unknown"
            label="Checkmarx Unknown Finding"
            icon="icons/severity/unknown_16.svg"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceValue="true"
            presentationLayer="3">
        </specification>
        <specification
            annotationType="com.checkmarx.eclipse.findings.ok"
            label="Checkmarx OK Finding"
            icon="icons/severity/ok_16.svg"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceValue="true"
            presentationLayer="2">
        </specification>
        <specification
            annotationType="com.checkmarx.eclipse.findings.ignored"
            label="Checkmarx Ignored Finding"
            icon="icons/severity/ignored_16.svg"
            textStylePreferenceValue="SQUIGGLES"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceValue="true"
            presentationLayer="1">
        </specification>
    </extension>

    <!-- Removed: All Problems View customizations (markers, commands, handlers, menus, toolbars) -->
    <!-- The custom Findings Window and editor decorations are now the sole UI for Checkmarx findings -->

    <!--
    DISABLED: Java Editor Text Hover for Checkmarx Findings annotations

    Reason: Using marker-based system (highlightViaMarker) uniformly for ALL languages
    - Both Java and Python files use Eclipse's native marker hover (yellow)
    - Consistent behavior across file types
    - No language-specific code paths
    -->
    <!--
    <extension point="org.eclipse.jdt.ui.javaEditorTextHovers">
        <hover
            id="com.checkmarx.eclipse.hover.java"
            label="Checkmarx Findings Hover"
            description="Displays Checkmarx vulnerability details in custom popup"
            class="com.checkmarx.eclipse.devassist.ui.findings.editor.CxFindingsHover">
        </hover>
    </extension>
    -->
    
    <!-- Universal hover for all languages (Java, Python, C++, etc) -->
	<extension point="org.eclipse.ui.editors.textHovers">
	    <hover
	        id="com.checkmarx.eclipse.hover.universal"
	        label="Checkmarx Findings Hover"
	        description="Displays Checkmarx vulnerability details"
	        class="com.checkmarx.eclipse.devassist.ui.findings.editor.CxFindingsHover">
	    </hover>
	</extension>

    <!-- Removed: Duplicate/incomplete markerAnnotationSpecification that was incomplete -->
    <!-- The complete annotation type specifications are defined above (lines 97-134) -->
    <!-- This was causing High, Medium, Low annotations to not render properly -->


</plugin>
