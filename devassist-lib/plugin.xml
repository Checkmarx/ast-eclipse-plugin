<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- Findings View Registration -->
   <extension
         point="org.eclipse.ui.views">
      <category
            id="com.checkmarx.eclipse.devassist.category"
            name="Checkmarx">
      </category>
      <view
            id="com.checkmarx.eclipse.devassist.ui.findings.CxFindingsView"
            name="Checkmarx One Assist Findings"
            icon="icons/checkmarx-plugin-13_dark.png"
            category="com.checkmarx.eclipse.devassist.category"
            class="com.checkmarx.eclipse.devassist.ui.findings.CxFindingsView"
            restorable="true">
      </view>
       <view
            id="com.checkmarx.eclipse.devassist.ui.findings.ignore.DevAssistIgnoredFindings"
            name="Ignored Findings"
            icon="icons/checkmarx-plugin-13_dark.png"
            category="com.checkmarx.eclipse.devassist.category"
            class="com.checkmarx.eclipse.devassist.ui.findings.ignore.DevAssistIgnoredFindings"
            restorable="true">
      </view>
   </extension>

   <!-- Line Hover (Java editor): org.eclipse.ui.editors.textHovers does NOT
        exist as a real Eclipse Platform extension point - text hovers are
        wired programmatically per-editor via SourceViewerConfiguration and
        cannot be injected into an editor a plugin doesn't own through a
        generic mechanism. JDT's own Java editor exposes the ONLY documented,
        public extension point for contributing an additional hover into an
        editor this plugin doesn't control: org.eclipse.jdt.ui.javaEditorTextHovers
        (the same point JDT itself uses for its Javadoc/Problem/BestMatch
        hovers - see org.eclipse.jdt.ui's own plugin.xml). JDT stacks multiple
        <hover> contributions rather than replacing a single slot, so this
        adds alongside JDT's existing hovers without hiding them.
        CheckmarxAnnotationHover implements org.eclipse.jdt.ui's
        IJavaEditorTextHover (required by JDT's hover framework, which casts
        contributed classes to this type), so org.eclipse.jdt.ui is a hard
        (non-optional) Require-Bundle dependency in MANIFEST.MF - this plugin
        now requires the JDT UI tooling to be installed.
        Coverage: .java files only. Other file types (Dockerfile, YAML, JSON,
        etc.) have no equivalent public extension point in stock Eclipse and
        fall back to Eclipse's built-in default marker hover (shows
        IMarker.MESSAGE and aggregates "Multiple markers at this line"
        automatically - no custom code needed, nothing is hidden).
        IMPORTANT - NOT VERIFIED YET: JDT gates which contributed hovers are
        actually shown via user preferences (Preferences > Java > Editor >
        Hovers), keyed by this hover's id, with an enabled/modifier-key state
        loaded from a preference store. Registering this extension makes the
        hover available/selectable in that preference page, but does NOT by
        itself guarantee the hover is active by default for a fresh install -
        this must be confirmed in a running Eclipse instance before this can
        be considered "working out of the box" rather than "available to
        enable".

        Remediation Link Handler: RemediationLinkHandler is wired into
        CheckmarxAnnotationHover's browser LocationListener to handle
        remediation actions (fix, view details, ignore) triggered from
        hover popup links. The link handler is instantiated and invoked
        programmatically (no extension point registration needed). -->
   <extension
         point="org.eclipse.jdt.ui.javaEditorTextHovers">
      <hover
            id="com.checkmarx.eclipse.devassist.hover.checkmarxAnnotationHover"
            class="com.checkmarx.eclipse.devassist.ui.findings.hover.CheckmarxAnnotationHover"
            label="Checkmarx Finding"
            description="Shows Checkmarx finding details, alongside other issues on the same line">
      </hover>
   </extension>

   <!-- Line Hover (all other text-based editors): org.eclipse.jdt.ui.javaEditorTextHovers
        above only reaches JDT's own Java editor. Every other file type this plugin
        scans (pom.xml, package.json, secrets.py, Dockerfiles, ...) that has no
        dedicated editor of its own falls back to the Platform's Generic Editor
        (org.eclipse.ui.genericeditor.GenericEditor), which has its own, separate
        hover extension point. CheckmarxAnnotationHover's content is already
        marker/annotation-based (not JDT-specific), so the same class is reused
        here unchanged. Unlike the JDT extension point, the Generic Editor combines
        all matching hoverProviders automatically (see CompositeTextHover) - no
        per-hover preference toggle needed for this one to show up.
        contentType="org.eclipse.core.runtime.text" is the Platform's base "Text"
        content type; org.eclipse.core.runtime.xml, .properties, and most
        language-specific content types declare it as their base-type, so this
        applies broadly rather than needing one registration per file type. -->
   <extension
         point="org.eclipse.ui.genericeditor.hoverProviders">
      <hoverProvider
            id="com.checkmarx.eclipse.devassist.hover.checkmarxGenericHoverProvider"
            class="com.checkmarx.eclipse.devassist.ui.findings.hover.CheckmarxAnnotationHover"
            contentType="org.eclipse.core.runtime.text">
      </hoverProvider>
   </extension>

   <!-- Annotation Types Extension Point (for in-editor vulnerability markers/highlights) -->
   <extension
